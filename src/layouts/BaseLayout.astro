---
import "../styles/global.css";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Archipelago Blog</title>
  </head>

  <body
    class="px-5 sm:px-8 py-8 sm:py-10 bg-stone-50 min-h-screen font-serif font-normal tracking-tight"
  >
    <header class="border-b border-green-700/20">
      <div class="max-w-3xl mx-auto">
        <div class="flex justify-between items-baseline pb-5 sm:pb-6">
          <a
            href="/"
            class="text-2xl sm:text-3xl text-gray-900 hover:text-green-700 transition-colors"
          >
            Archipelago
          </a>

          <a
            href="/about"
            class="text-sm text-gray-500 hover:text-green-700 transition-colors"
          >
            About
          </a>
        </div>
      </div>
    </header>

    <slot />
  </body>
</html>
