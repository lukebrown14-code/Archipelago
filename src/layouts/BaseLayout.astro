---
import "@fontsource/anton";
import "@fontsource/space-mono";
import "@fontsource/space-mono/700.css";
import "@fontsource/space-mono/400-italic.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Archipelago",
  description = "Opinions & essays on books, philosophy, technology, and culture.",
} = Astro.props;

const pageTitle = title === "Archipelago" ? title : `${title} — Archipelago`;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="alternate" type="application/rss+xml" title="Archipelago" href="/rss.xml" />
    <script is:inline>
      if (localStorage.getItem("theme") === "dark" ||
        (!localStorage.getItem("theme") && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
        document.documentElement.classList.add("dark");
      }
    </script>
  </head>

  <body
    class="px-5 sm:px-8 pb-8 sm:pb-10 bg-[var(--color-bg)] text-[var(--color-text)] min-h-screen font-sans font-normal tracking-tight transition-colors"
  >
    <header class="-mx-5 sm:-mx-8 px-5 sm:px-8 border-b-4 border-[var(--color-secondary)]">
      <div class="max-w-3xl mx-auto flex flex-col items-center py-6 sm:py-8">
        <span class="text-xs uppercase tracking-widest text-[var(--color-text)]/50 font-mono">
          Opinions &amp; Essays
        </span>

        <a
          href="/"
          class="text-5xl sm:text-7xl font-serif uppercase tracking-[0.25em] text-[var(--color-text)] hover:text-[var(--color-secondary)] mt-3 sm:mt-4"
        >
          Archipelago
        </a>

        <nav class="flex items-center gap-5 mt-4 sm:mt-5 text-xs uppercase tracking-widest font-bold font-mono">
          <a
            href="/about"
            class="text-[var(--color-text)] hover:text-[var(--color-secondary)]"
          >
            [ About ]
          </a>
          <a
            href="/rss.xml"
            class="text-[var(--color-text)] hover:text-[var(--color-secondary)]"
          >
            [ RSS ]
          </a>
          <button
            id="theme-toggle"
            type="button"
            class="text-[var(--color-text)] hover:text-[var(--color-secondary)]"
            aria-label="Toggle dark mode"
          >
            <svg id="sun-icon" class="hidden dark:block w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="12" cy="12" r="5" />
              <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
            </svg>
            <svg id="moon-icon" class="block dark:hidden w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M21 12.79A9 9 0 1 1 11.21 3a7 7 0 0 0 9.79 9.79z" />
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="-mx-5 sm:-mx-8 px-5 sm:px-8 border-t-4 border-[var(--color-secondary)] mt-12">
      <div class="max-w-3xl mx-auto py-6 sm:py-8 text-center font-mono text-xs uppercase tracking-widest text-[var(--color-text)]/40">
        <p>&copy; 2026 Archipelago</p>
        <p class="mt-1">Opinions &amp; Essays &middot; Est. 2025</p>
      </div>
    </footer>

    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const isDark = document.documentElement.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
      });
    </script>
  </body>
</html>
