---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostMeta from "@/components/PostMeta.astro";
import { getReadingTime } from "@/utils/readingTime";

interface Props {
  title: string;
  description?: string;
  category?: string;
  date?: Date;
  body?: string;
}

const { title, description, category, date, body } = Astro.props;

const readingTime = getReadingTime(body);
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl py-10 md:py-14">
    <a
      href="/"
      class="inline-block text-xs font-mono uppercase tracking-widest text-[var(--color-text)]/40 hover:text-[var(--color-secondary)] mb-6"
    >
      &larr; Back
    </a>

    <header class="mb-8 md:mb-12">
      <h1 class="text-3xl sm:text-4xl font-serif uppercase tracking-wide text-[var(--color-text)] mb-3 leading-tight">
        {title}
      </h1>

      {
        description && (
          <p class="text-xl md:text-2xl text-[var(--color-text)]/60 font-light max-w-2xl md:mx-0">
            {description}
          </p>
        )
      }

      <div class="mt-2">
        <PostMeta date={date} category={category} readingTime={readingTime} />
      </div>

      <div class="border-t-2 border-[var(--color-text)]/20 mt-6"></div>
    </header>

    <div class="blog-content">
      <slot />
    </div>
  </article>
</BaseLayout>
