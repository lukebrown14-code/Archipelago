---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PostMeta from "@/components/PostMeta.astro";
import TableOfContents from "@/components/TableOfContents.astro";
import { getReadingTime } from "@/utils/readingTime";

interface Props {
  title: string;
  description?: string;
  category?: string;
  date?: Date;
  body?: string;
  headings?: { depth: number; slug: string; text: string }[];
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
}

const {
  title,
  description,
  category,
  date,
  body,
  headings = [],
  prevPost,
  nextPost,
} = Astro.props;
const showToc = headings.length >= 2;

const readingTime = getReadingTime(body);
---

<BaseLayout title={title} description={description}>
  <div
    id="progress-bar"
    class="fixed top-0 left-0 h-0.75 bg-(--color-secondary) z-50 transition-none"
    style="width: 0%"
  >
  </div>

  {
    showToc ? (
      <div class="mx-auto max-w-3xl xl:max-w-6xl xl:flex xl:gap-10 py-10 md:py-14">
        <aside class="hidden xl:block w-56 shrink-0">
          <div class="sticky top-20">
            <TableOfContents headings={headings} />
          </div>
        </aside>

        <article id="article" class="max-w-3xl flex-1 min-w-0">
          <a
            href="/"
            class="inline-block text-xs font-mono uppercase tracking-widest text-(--color-text)/4 hover:text-[var(--color-secondary)] mb-6"
          >
            &larr; Back
          </a>

          <header class="mb-8 md:mb-12">
            <h1 class="text-3xl sm:text-4xl font-serif uppercase tracking-wide text-[var(--color-text)] mb-3 leading-tight">
              {title}
            </h1>

            {description && (
              <p class="text-xl md:text-2xl text-[var(--color-text)]/60 font-light max-w-2xl md:mx-0">
                {description}
              </p>
            )}

            <div class="mt-2">
              <PostMeta
                date={date}
                category={category}
                readingTime={readingTime}
              />
            </div>

            <div class="border-t-2 border-[var(--color-text)]/20 mt-6" />
          </header>

          <div class="xl:hidden mb-6 -mt-4">
            <TableOfContents headings={headings} open={false} />
          </div>

          <div class="blog-content">
            <slot />
          </div>
        </article>
      </div>
    ) : (
      <article id="article" class="mx-auto max-w-3xl py-10 md:py-14">
        <a
          href="/"
          class="inline-block text-xs font-mono uppercase tracking-widest text-[var(--color-text)]/40 hover:text-[var(--color-secondary)] mb-6"
        >
          &larr; Back
        </a>

        <header class="mb-8 md:mb-12">
          <h1 class="text-3xl sm:text-4xl font-serif uppercase tracking-wide text-[var(--color-text)] mb-3 leading-tight">
            {title}
          </h1>

          {description && (
            <p class="text-xl md:text-2xl text-[var(--color-text)]/60 font-light max-w-2xl md:mx-0">
              {description}
            </p>
          )}

          <div class="mt-2">
            <PostMeta
              date={date}
              category={category}
              readingTime={readingTime}
            />
          </div>

          <div class="border-t-2 border-[var(--color-text)]/20 mt-6" />
        </header>

        <div class="blog-content">
          <slot />
        </div>
      </article>
    )
  }

  {
    (prevPost || nextPost) && (
      <nav class="mx-auto max-w-3xl border-t-2 border-[var(--color-text)]/20 py-8 flex justify-between items-start">
        <div>
          {prevPost && (
            <a
              href={`/blog/${prevPost.slug}/`}
              class="text-xs font-mono uppercase tracking-widest text-[var(--color-text)]/40 hover:text-[var(--color-secondary)]"
            >
              &larr; Older
            </a>
          )}
        </div>
        <div>
          {nextPost && (
            <a
              href={`/blog/${nextPost.slug}/`}
              class="text-xs font-mono uppercase tracking-widest text-[var(--color-text)]/40 hover:text-[var(--color-secondary)]"
            >
              Newer &rarr;
            </a>
          )}
        </div>
      </nav>
    )
  }
</BaseLayout>

<script>
  const bar = document.getElementById("progress-bar");
  const article = document.getElementById("article");

  if (bar && article) {
    window.addEventListener(
      "scroll",
      () => {
        const rect = article.getBoundingClientRect();
        const articleTop = rect.top + window.scrollY;
        const articleHeight = article.offsetHeight;
        const viewportHeight = window.innerHeight;
        const scrollY = window.scrollY;

        const progress = Math.min(
          100,
          Math.max(
            0,
            ((scrollY - articleTop) / (articleHeight - viewportHeight)) * 100,
          ),
        );

        bar.style.width = `${progress}%`;
      },
      { passive: true },
    );
  }
</script>
