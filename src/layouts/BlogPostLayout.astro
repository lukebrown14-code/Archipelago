---
import HomeLayout from "./HomeLayout.astro";
const { title, description } = Astro.props;
---

<HomeLayout>
  <article
    class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10 md:py-16 lg:py-20"
  >
    <!-- Header with better spacing and hierarchy -->
    <header class="mb-10 md:mb-14 lg:mb-16 text-center md:text-left">
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl font-serif font-bold tracking-tight text-gray-900 mb-4 leading-tight"
      >
        {title}
      </h1>

      {
        description && (
          <p class="text-xl md:text-2xl text-gray-600 font-light max-w-2xl mx-auto md:mx-0">
            {description}
          </p>
        )
      }

      <!-- Optional: add date, author, reading time here if available -->
      <!-- <div class="mt-6 text-sm text-gray-500 flex items-center justify-center md:justify-start gap-6">
          <time>January 29, 2026</time>
          <span>·</span>
          <span>8 min read</span>
        </div> -->
    </header>

    <!-- Main content with enhanced prose typography -->
    <div
      class="prose prose-lg prose-headings:font-serif prose-headings:tracking-tight prose-headings:text-gray-900
                  prose-p:text-gray-700 prose-p:leading-relaxed
                  prose-a:text-green-700 prose-a:no-underline hover:prose-a:underline
                  prose-blockquote:border-l-4 prose-blockquote:border-green-700 prose-blockquote:pl-5 prose-blockquote:italic prose-blockquote:text-gray-600
                  prose-img:rounded-xl prose-img:shadow-md prose-img:mx-auto
                  prose-ul:list-disc prose-ol:list-decimal
                  max-w-none text-black"
    >
      <slot />
    </div>
  </article>
</HomeLayout>
