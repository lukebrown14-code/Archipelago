---
import BaseLayout from "./BaseLayout.astro";
const { title, description, category, date } = Astro.props;
---

<BaseLayout>
  <article
    class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10 md:py-16 lg:py-20"
  >
    <header class="mb-10 md:mb-14 lg:mb-16 text-center md:text-left">
      <h1
        class="text-4xl sm:text-5xl lg:text-6xl text-gray-900 mb-4 leading-tight"
      >
        {title}
      </h1>

      {
        description && (
          <p class="text-xl md:text-2xl text-gray-600 font-light max-w-2xl mx-auto md:mx-0">
            {description}
          </p>
        )
      }

      {
        (date || category) && (
          <div class="mt-4 flex items-center gap-3">
            {date && (
              <time class="text-sm text-gray-500">
                {date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
              </time>
            )}
            {category && (
              <span class="rounded-full bg-green-700/10 px-3 py-1 text-sm text-green-700">
                {category}
              </span>
            )}
          </div>
        )
      }

    </header>

    <div class="blog-content">
      <slot />
    </div>
  </article>
</BaseLayout>
