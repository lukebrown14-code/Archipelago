---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  open?: boolean;
}

const { headings, open = true } = Astro.props;
---

<nav data-toc>
  <details {...open ? { open: true } : {}}>
    <summary
      class="text-xs font-mono font-normal uppercase tracking-widest text-(--color-text)/40 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden mb-3 flex items-center gap-1.5"
    >
      <svg
        data-toc-chevron
        class={`w-3 h-3 transition-transform ${open ? "rotate-90" : ""}`}
        viewBox="0 0 12 12"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      >
        <path d="M4.5 2.5L8 6L4.5 9.5"></path>
      </svg>
      Contents
    </summary>
    <ul class="space-y-2">
      {
        headings.map((h) => (
          <li class={h.depth === 3 ? "pl-3" : ""}>
            <a
              href={`#${h.slug}`}
              data-toc-link
              data-slug={h.slug}
              class="text-xs font-mono font-normal uppercase tracking-widest text-(--color-text)/40 hover:text-(--color-secondary transition-colors"
            >
              {h.text}
            </a>
          </li>
        ))
      }
    </ul>
  </details>
</nav>

<script>
  {
    const links =
      document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    if (links.length > 0) {
      const slugs = Array.from(links).map((l) => l.dataset.slug!);
      const headingEls = slugs
        .map((s) => document.getElementById(s))
        .filter(Boolean) as HTMLElement[];

      function setActive(slug: string) {
        links.forEach((link) => {
          if (link.dataset.slug === slug) {
            link.classList.remove("text-(--color-text)/40");
            link.classList.add("text-(--color-secondary)");
          } else {
            link.classList.remove("text-(--color-secondary)");
            link.classList.add("text-(--color-text)/40");
          }
        });
      }

      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              setActive(entry.target.id);
              break;
            }
          }
        },
        { rootMargin: "0px 0px -80% 0px", threshold: 0 },
      );

      headingEls.forEach((el) => observer.observe(el));
    }

    document.querySelectorAll<HTMLElement>("[data-toc]").forEach((nav) => {
      const det = nav.querySelector("details");
      const chev = nav.querySelector("[data-toc-chevron]");
      if (det && chev) {
        det.addEventListener("toggle", () => {
          chev.classList.toggle("rotate-90", det.open);
        });
      }
    });
  }
</script>
