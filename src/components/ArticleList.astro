---
// src/components/ArticleList.astro
// Example usage: <ArticleList posts={Astro.props.posts} />

interface Post {
  slug: string;
  title: string;
  date: string; // e.g. "2025-12-08" or "December 8, 2025"
  description?: string; // optional excerpt
}

const { posts = [] } = Astro.props as { posts: Post[] };
---

<section class="py-12 md:py-20 border-b-2">
  <div class="mx-auto max-w-2xl px-5">
    <ul class="space-y-10 md:space-y-16">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="group block transition-colors hover:text-gray-900"
            >
              <time datetime={post.date} class="block text-sm text-gray-500">
                {new Date(post.date).toLocaleDateString("en-US", {
                  year: "numeric",
                  month: "long",
                  day: "numeric",
                })}
              </time>

              <h2 class="mt-1.5 text-2xl font-serif font-normal tracking-tight text-gray-900 group-hover:underline group-hover:underline-offset-4">
                {post.title}
              </h2>

              {post.description && (
                <p class="mt-2.5 text-gray-600 line-clamp-2 md:line-clamp-3">
                  {post.description}
                </p>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    {
      posts.length === 0 && (
        <p class="text-center text-gray-500 py-20">No articles yet.</p>
      )
    }
  </div>
</section>
