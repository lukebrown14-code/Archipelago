---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<section class="py-1 md:py-5">
  <div class="mx-auto max-w-2xl px-5">
    <ul class="space-y-1 md:space-y-10">
      {
        posts.map((post) => (
          <li>
            <a
              href={`/blog/${post.slug}`}
              class="group block transition-colors hover:text-gray-900 "
            >
              <h2 class="mt-1.5 text-2xl font-serif font-normal tracking-tight text-gray-900 group-hover:underline group-hover:underline-offset-4">
                {post.data.title}
              </h2>

              {post.data.description && (
                <p class="mt-1 text-gray-600 line-clamp-2 md:line-clamp-3">
                  {post.data.description}
                </p>
              )}
            </a>
          </li>
        ))
      }
    </ul>

    {
      posts.length === 0 && (
        <p class="text-center text-gray-500 py-20">No articles yet.</p>
      )
    }
  </div>
</section>
