---
// src/pages/blog/index.astro
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<div class="pt-6 pl-6">
  <ul class="space-y-2">
    {
      posts.map((post) => (
        <li class="text-xl">
          <a href={`/blog/${post.slug}`}>{post.data.title}</a>
        </li>
      ))
    }
  </ul>
</div>
