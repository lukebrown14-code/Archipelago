---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))].sort();

function getReadingTime(body?: string) {
  if (!body) return null;
  return Math.max(1, Math.round(body.split(/\s+/).length / 230));
}
---

<section class="py-8 md:py-12">
  <div class="mx-auto max-w-5xl">
    <div class="flex flex-col md:flex-row">
      {/* Left sidebar — filters */}
      {categories.length > 0 && (
        <div class="md:w-48 shrink-0 border-b md:border-b-0 md:border-r border-[var(--color-text)]/30 py-4 md:py-6 md:pr-6" id="category-filters">
          <div class="text-[10px] uppercase tracking-widest font-mono text-[var(--color-text)]/30 mb-3">Sections</div>
          <div class="flex flex-wrap md:flex-col gap-x-4 gap-y-1">
            <button data-filter="all" class="filter-btn active text-xs uppercase tracking-widest font-mono font-bold text-[var(--color-secondary)] text-left">
              [ ALL ]
            </button>
            {categories.map((cat) => (
              <button data-filter={cat} class="filter-btn text-xs uppercase tracking-widest font-mono text-[var(--color-text)]/40 hover:text-[var(--color-secondary)] text-left">
                [ {cat} ]
              </button>
            ))}
          </div>
        </div>
      )}

      {/* Right column — articles */}
      <div class="flex-1 md:pl-6">
        {
          posts.length === 0 ? (
            <p class="text-[var(--color-text)]/50 py-12 font-mono text-sm uppercase tracking-widest">No articles yet.</p>
          ) : (
            <div id="post-list">
              {
                posts.map((post, i) => {
                  const isLead = i === 0;
                  const readingTime = getReadingTime(post.body);
                  return (
                    <>
                      {i > 0 && (
                        <div class:list={[
                          "border-t",
                          isLead ? "" : "border-dashed",
                          i === 1 ? "border-[var(--color-text)]/40 border-t-2" : "border-[var(--color-text)]/20",
                        ]}></div>
                      )}
                      <a
                        href={`/blog/${post.slug}`}
                        class="group block py-6 sm:py-8"
                        data-category={post.data.category || ""}
                      >
                        <h2 class:list={[
                          "font-serif uppercase tracking-wide text-[var(--color-text)] hover:text-[var(--color-secondary)]",
                          isLead ? "text-4xl sm:text-5xl" : "text-2xl sm:text-3xl",
                        ]}>
                          {post.data.title}
                        </h2>

                        {post.data.description && (
                          <p class:list={[
                            "mt-1 text-[var(--color-text)]/50",
                            isLead ? "text-base sm:text-lg mt-3" : "text-sm",
                          ]}>
                            {post.data.description}
                          </p>
                        )}

                        {(post.data.date || post.data.category || readingTime) && (
                          <div class="mt-2 text-xs font-mono uppercase tracking-widest text-[var(--color-text)]/30">
                            {post.data.date && (
                              <time>
                                {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                              </time>
                            )}
                            {post.data.date && post.data.category && (
                              <span> · </span>
                            )}
                            {post.data.category && (
                              <span>{post.data.category}</span>
                            )}
                            {(post.data.date || post.data.category) && readingTime && (
                              <span> · </span>
                            )}
                            {readingTime && (
                              <span>{readingTime} min read</span>
                            )}
                          </div>
                        )}
                      </a>
                    </>
                  );
                })
              }
            </div>
          )
        }
      </div>
    </div>

  </div>
</section>

<script>
  const filters = document.getElementById("category-filters");
  const postList = document.getElementById("post-list");
  const posts = postList?.querySelectorAll<HTMLAnchorElement>("a[data-category]") ?? [];
  const dividers = postList?.querySelectorAll<HTMLDivElement>(":scope > div") ?? [];

  filters?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-btn");
    if (!btn) return;

    const selected = btn.dataset.filter;

    filters.querySelectorAll(".filter-btn").forEach((b) => {
      b.classList.remove("active", "font-bold", "text-[var(--color-secondary)]");
      b.classList.add("text-[var(--color-text)]/40");
    });
    btn.classList.add("active", "font-bold", "text-[var(--color-secondary)]");
    btn.classList.remove("text-[var(--color-text)]/40");

    posts.forEach((post) => {
      const show = selected === "all" || post.dataset.category === selected;
      post.style.display = show ? "" : "none";
    });

    // Hide dividers next to hidden posts
    dividers.forEach((div) => {
      const nextArticle = div.nextElementSibling as HTMLAnchorElement | null;
      const prevArticle = div.previousElementSibling as HTMLAnchorElement | null;
      if (nextArticle?.style.display === "none" || prevArticle?.style.display === "none") {
        div.style.display = "none";
      } else {
        div.style.display = "";
      }
    });
  });
</script>
