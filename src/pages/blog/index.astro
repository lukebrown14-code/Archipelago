---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<section class="py-6 md:py-12 lg:py-16">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    {
      posts.length === 0 ? (
        <p class="text-center text-gray-500 py-20 text-lg">
          No articles yet.
        </p>
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:gap-8">
          {
            posts.map((post) => (
              <article class="group relative overflow-hidden rounded-xl border border-gray-200 bg-white transition-all hover:border-gray-300 hover:shadow-md hover:-translate-y-1">
                <a
                  href={`/blog/${post.slug}`}
                  class="block h-full p-6"
                >
                  <h2 class="mb-3 text-xl font-serif font-normal tracking-tight text-gray-900 group-hover:underline group-hover:underline-offset-4 md:text-2xl">
                    {post.data.title}
                  </h2>

                  {post.data.description && (
                    <p class="text-gray-600 line-clamp-2 md:line-clamp-3 lg:line-clamp-4">
                      {post.data.description}
                    </p>
                  )}

                  {(post.data.date || post.data.category) && (
                    <div class="mt-3 flex items-center gap-3">
                      {post.data.date && (
                        <time class="text-sm text-gray-500">
                          {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                        </time>
                      )}
                      {post.data.category && (
                        <span class="rounded-full bg-green-700/10 px-3 py-1 text-sm text-green-700">
                          {post.data.category}
                        </span>
                      )}
                    </div>
                  )}

                </a>
              </article>
            ))
          }
        </div>
      )
    }
  </div>
</section>
