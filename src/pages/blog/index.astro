---
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0)
);
const categories = [...new Set(posts.map((p) => p.data.category).filter(Boolean))].sort();
---

<section class="py-8 md:py-12">
  <div class="mx-auto max-w-3xl">
    {categories.length > 0 && (
      <div class="flex flex-wrap gap-2 mb-6" id="category-filters">
        <button data-filter="all" class="filter-btn active text-sm px-3 py-1 rounded-full border border-[var(--color-secondary)] bg-[var(--color-secondary)] text-white transition-colors">
          All
        </button>
        {categories.map((cat) => (
          <button data-filter={cat} class="filter-btn text-sm px-3 py-1 rounded-full border border-[var(--color-text)]/30 text-[var(--color-text)]/60 hover:border-[var(--color-secondary)] hover:text-[var(--color-secondary)] transition-colors">
            {cat}
          </button>
        ))}
      </div>
    )}

    {
      posts.length === 0 ? (
        <p class="text-[var(--color-text)]/50 py-12">No articles yet.</p>
      ) : (
        <div class="divide-y divide-[var(--color-secondary)]/20" id="post-list">
          {
            posts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="group block py-5 first:pt-0"
                data-category={post.data.category || ""}
              >
                <h2 class="text-lg font-serif text-[var(--color-text)] group-hover:text-[var(--color-secondary)] transition-colors">
                  {post.data.title}
                </h2>

                {post.data.description && (
                  <p class="mt-1 text-[var(--color-text)]/50 text-sm line-clamp-2">
                    {post.data.description}
                  </p>
                )}

                {(post.data.date || post.data.category) && (
                  <div class="mt-2 flex items-center gap-3">
                    {post.data.date && (
                      <time class="text-xs text-[var(--color-text)]/40">
                        {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                      </time>
                    )}
                    {post.data.category && (
                      <span class="text-xs text-[var(--color-secondary)]/60">
                        {post.data.category}
                      </span>
                    )}
                  </div>
                )}
              </a>
            ))
          }
        </div>
      )
    }
  </div>
</section>

<script>
  const filters = document.getElementById("category-filters");
  const posts = document.querySelectorAll<HTMLAnchorElement>("#post-list a[data-category]");

  filters?.addEventListener("click", (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>(".filter-btn");
    if (!btn) return;

    const selected = btn.dataset.filter;

    filters.querySelectorAll(".filter-btn").forEach((b) => {
      b.classList.remove("active", "bg-[var(--color-secondary)]", "text-white", "border-[var(--color-secondary)]");
      b.classList.add("border-[var(--color-text)]/30", "text-[var(--color-text)]/60");
    });
    btn.classList.add("active", "bg-[var(--color-secondary)]", "text-white", "border-[var(--color-secondary)]");
    btn.classList.remove("border-[var(--color-text)]/30", "text-[var(--color-text)]/60");

    posts.forEach((post) => {
      const show = selected === "all" || post.dataset.category === selected;
      post.style.display = show ? "" : "none";
    });
  });
</script>
