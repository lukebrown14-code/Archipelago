---
import { getCollection } from "astro:content";

const posts = await getCollection("blog");
---

<section class="py-8 md:py-12">
  <div class="mx-auto max-w-3xl">
    {
      posts.length === 0 ? (
        <p class="text-gray-500 py-12">No articles yet.</p>
      ) : (
        <div class="divide-y divide-green-700/20">
          {
            posts.map((post) => (
              <a
                href={`/blog/${post.slug}`}
                class="group block py-5 first:pt-0"
              >
                <h2 class="text-lg font-serif text-gray-900 group-hover:text-green-700 transition-colors">
                  {post.data.title}
                </h2>

                {post.data.description && (
                  <p class="mt-1 text-gray-500 text-sm line-clamp-2">
                    {post.data.description}
                  </p>
                )}

                {(post.data.date || post.data.category) && (
                  <div class="mt-2 flex items-center gap-3">
                    {post.data.date && (
                      <time class="text-xs text-gray-400">
                        {post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
                      </time>
                    )}
                    {post.data.category && (
                      <span class="text-xs text-green-700/60">
                        {post.data.category}
                      </span>
                    )}
                  </div>
                )}
              </a>
            ))
          }
        </div>
      )
    }
  </div>
</section>
