---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="404 — Page Not Found">
  <div class="mx-auto max-w-3xl py-20 md:py-32 text-center">
    <h1 class="text-6xl sm:text-8xl font-serif uppercase tracking-wide text-(--color-text) mb-6">
      404
    </h1>
    <p class="text-lg font-mono text-(--color-text)/60 mb-10">
      This page has drifted beyond the archipelago.
    </p>
    <a
      href="/"
      class="text-xs font-mono uppercase tracking-widest text-(--color-text)/40 hover:text-(--color-secondary)"
    >
      &larr; Back to shore
    </a>
  </div>
</BaseLayout>
